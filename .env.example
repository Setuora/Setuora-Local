APP_NAME=Setuora QR Tally Bridge
APP_SECRET_KEY=change-this-before-production
DATABASE_URL=sqlite:///./data/setuora.db
SESSION_TIMEOUT_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
# Set to true when served over HTTPS (e.g. behind Caddy / in Docker) so the
# session cookie is only sent over secure connections.
SESSION_COOKIE_SECURE=false
# Comma-separated names or addresses that may reach FastAPI through the proxy.
TRUSTED_HOSTS=setuora.local,127.0.0.1,localhost
# Failed-login throttle (per username).
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Verified automatic SQLite backups.
AUTOMATIC_BACKUPS_ENABLED=true
BACKUP_DIRECTORY=./data/backups
# Optional: use another drive or network share for an off-machine copy.
BACKUP_OFFSITE_DIRECTORY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_STARTUP_DELAY_SECONDS=60
